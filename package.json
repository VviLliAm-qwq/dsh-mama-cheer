{
  "name": "dsh-mama-cheer",
  "version": "0.2.0",
  "description": "Keyboard shortcut that injects an encouraging message into the running dsh-TUI conversation: steer when a tool is in flight, interrupt-and-deliver when the model is only streaming text",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VviLliAm-qwq/dsh-mama-cheer.git"
  },
  "author": "VviLliAm-qwq",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tui",
    "deepseek-harness",
    "deepseek",
    "shortcut",
    "keyboard",
    "agent-inbox",
    "steer",
    "interrupt",
    "settings"
  ],
  "files": [
    "lib",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "check:encoding": "node scripts/check-encoding.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "node --test",
    "pack:verify": "node scripts/pack-verify.mjs",
    "verify": "npm run check:encoding && npm run validate:manifest && npm test && npm run pack:verify",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
